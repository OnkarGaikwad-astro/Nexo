# ============================================================
# NEXO: Autonomous AI Task Worker Environment Configuration
# ============================================================

# LLM Cognitive Engine Configuration (Groq / Gemini / OpenAI)
# Free Groq API Key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=qwen/qwen3.8-27b

# Local Portals & Services
BACKEND_URL=http://localhost:8000
COMPANY_SIM_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Browser Automation (Set to true in Docker / Cloud / Headless servers; false for local GUI popups)
HEADLESS=true

# Optional: Outbound Email Dispatcher (Gmail SMTP)
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=your_email@gmail.com

# Optional: Real Internet Search (Tavily Search API)
# Free key at: https://tavily.com (DuckDuckGo fallback active if left blank)
TAVILY_API_KEY=
